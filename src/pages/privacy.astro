---
import BaseLayout from '@layouts/BaseLayout.astro';
import { brand, legal, links, isPlaceholder } from '@data/site';

const analytics = isPlaceholder(legal.analyticsProvider) ? null : legal.analyticsProvider;
const newsletter = !isPlaceholder(links.newsletterEndpoint);
---

<BaseLayout
  title="Privacy Policy"
  description={`What ${brand.appName} collects, who we share it with, and how to get your data out or delete it.`}
>
  <section class="section">
    <div class="container container--narrow">
      <header class="legal-head">
        <p class="eyebrow">Legal</p>
        <h1 class="h2">Privacy Policy</h1>
        <p class="faint">Effective {legal.effectiveDate}</p>
      </header>

      <div class="prose">
        <h2>Overview</h2>
        <p>
          This policy explains what we collect and what we do with it. By using {brand.appName}, you
          agree to this policy.
        </p>

        <h2>Information the app collects</h2>
        <ul>
          <li>
            <strong>Account</strong> — an email address and password, or the identifier Apple
            returns from Sign in with Apple. This exists so your history can reach your other
            device; it is not used for marketing.
          </li>
          <li>
            <strong>Training data</strong> — workouts, sets, exercises and notes you enter. Stored
            locally on your device and synced to our hosted database, where row-level security
            scopes every row to the account that created it.
          </li>
          <li>
            <strong>Voice</strong> — the microphone is used only while you are dictating a set. On
            iPhone, speech is transcribed on your device by Apple's speech framework. On Apple
            Watch, dictation is handled by the watch's own system dictation screen, so Apple's
            privacy terms cover that step. Either way, the app never records, stores or uploads the
            audio, and only the parsed numbers are saved.
          </li>
          <li>
            <strong>Diagnostics</strong> — if you opt in to sharing crash reports with Apple, we may
            see aggregated, anonymised crash logs.
          </li>
        </ul>

        <h2>Information this website collects</h2>
        <ul>
          <li>
            <strong>Analytics</strong> —{' '}
            {
              analytics
                ? `we use ${analytics} to count page views. It is configured without cookies and does not build a profile of you.`
                : 'we do not run analytics on this site. If that changes, this section will be updated before it does.'
            }
          </li>
          <li>
            <strong>Newsletter</strong> —{' '}
            {
              newsletter
                ? 'if you subscribe, your email address is stored by our email provider solely to send you product updates. Every email includes an unsubscribe link.'
                : 'the signup currently opens your email app, so your address only reaches us if you choose to send the message.'
            }
          </li>
          <li>
            <strong>Contact</strong> — messages you send us, including your email address, so we can
            reply.
          </li>
          <li>
            <strong>Hosting</strong> — this site is served by GitHub Pages, which records standard
            server request logs, including IP addresses. See GitHub's own privacy statement for
            details.
          </li>
        </ul>

        <h2>Embedded content</h2>
        <p>
          Video thumbnails on this site are static images. A YouTube player only loads after you
          press play, at which point YouTube may set cookies and receive your IP address under
          Google's privacy policy. If you never press play, no request goes to YouTube.
        </p>

        <h2>Who we share it with</h2>
        <p>
          We share information with service providers that help us operate {brand.appName},
          including infrastructure, authentication, billing, analytics, and error monitoring.
          Depending on the feature, those providers may include Supabase and Apple.
        </p>
        <p>
          We may also share data when required by law, to protect rights or security, in connection
          with a merger or asset sale, or at your direction.
        </p>

        <h2>Security</h2>
        <p>
          We use reasonable safeguards to protect your information, including encrypted connections
          and access controls. We work to protect your data from unauthorized access, use, or
          disclosure.
        </p>

        <h2>Keeping and deleting your data</h2>
        <p>
          We keep your data for as long as your account exists, because the app can't show you your
          training history without it.
        </p>

        <div class="callout">
          <strong>To delete your account: Settings → Account → Delete Account.</strong>
          This permanently deletes your account, your profile, and your workouts from our servers. It
          can't be undone.
        </div>

        <p>Two things worth knowing:</p>
        <ul>
          <li>
            Deleting your account doesn't erase the copy stored on your iPhone or Watch. To remove
            that, delete the app.
          </li>
          <li>
            When you delete a single workout in the app, we keep a marker on our servers so the
            deletion reaches your other devices. We erase those markers after 90 days.
          </li>
        </ul>

        <h2>Your rights</h2>
        <p>You can:</p>
        <ul>
          <li>
            <strong>See and export your data</strong> — Settings → Export Data gives you a CSV of
            your workout history
          </li>
          <li>
            <strong>Correct it</strong> — edit your workouts, routines, and custom exercises any time
          </li>
          <li><strong>Delete it</strong> — Settings → Account → Delete Account</li>
          <li>
            <strong>Turn off permissions</strong> — microphone, speech, and notifications can all be
            revoked in your device settings
          </li>
        </ul>
        <p>
          You can ask us for a copy of any personal data we hold about you, ask us to correct it, or
          ask us to delete it. Email <a href={`mailto:${brand.email}`}>{brand.email}</a> and we will
          respond within 30 days.
        </p>

        <h2>Children</h2>
        <p>
          {brand.appName} isn't intended for children under 13, and we don't knowingly collect their
          information. If you think a child has given us data, email us and we'll delete it.
        </p>

        <h2>Changes</h2>
        <p>
          If this policy changes materially, we will update the effective date above and note the
          change in the app's release notes.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about this policy: <a href={`mailto:${brand.email}`}>{brand.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-head {
    margin-bottom: var(--space-l);
  }

  .legal-head > * + * {
    margin-top: var(--space-2xs);
  }

  .callout {
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--brand);
    border-radius: var(--radius-m);
    background: var(--bg-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .callout strong {
    display: block;
    color: var(--text);
  }
</style>
