---
/**
 * The conversion block: install, join the beta, subscribe, or get in touch.
 * The newsletter form posts to links.newsletterEndpoint. While that is still a
 * placeholder it renders as a prefilled email link instead of a dead form.
 */
import { cta, links, brand, isPlaceholder, mailto } from '@data/site';
import { withBase } from '@utils/url';
import StoreButtons from './StoreButtons.astro';
import Icon from './Icon.astro';

const formReady = !isPlaceholder(links.newsletterEndpoint);
const subscribeByEmail = mailto(
  `Add me to the ${brand.appName} launch list`,
  'Hi — please add this address to the launch updates list. Thanks!'
);
---

<section class="section" id="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta" data-reveal>
      <div class="cta__glow" aria-hidden="true"></div>

      <div class="cta__main">
        <p class="eyebrow">Get started</p>
        <h2 class="h2" id="cta-title">{cta.heading}</h2>
        <p class="lead cta__lead">{cta.subheading}</p>

        <StoreButtons size="lg" note="Free during the beta · Requires iOS 17 or later" />

        <p class="cta__contact">
          Questions first? <a href={withBase('/#contact')}>Send me a message</a> — it comes straight
          to my inbox.
        </p>
      </div>

      <aside class="cta__side" aria-labelledby="newsletter-title">
        <span class="card__icon"><Icon name="mail" size={21} /></span>
        <h3 class="h4" id="newsletter-title">{cta.newsletter.heading}</h3>
        <p class="muted cta__side-body">{cta.newsletter.body}</p>

        {
          formReady ? (
            <form
              class="form-row form-row--inline"
              action={links.newsletterEndpoint}
              method="post"
              target="_blank"
            >
              <label class="visually-hidden" for="newsletter-email">
                Email address
              </label>
              <input
                class="input"
                id="newsletter-email"
                type="email"
                name="email"
                autocomplete="email"
                required
                placeholder={cta.newsletter.placeholder}
              />
              <button class="btn btn--primary" type="submit">
                {cta.newsletter.buttonLabel}
              </button>
            </form>
          ) : (
            <a class="btn btn--primary btn--block" href={subscribeByEmail}>
              <Icon name="mail" size={18} />
              Email me the launch updates
            </a>
          )
        }

        <p class="cta__fine">
          {
            formReady
              ? 'One email a month. Unsubscribe any time.'
              : 'No form service connected yet — this opens your email app.'
          }
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg-soft);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .cta {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
      padding: var(--space-2xl);
      align-items: center;
    }
  }

  .cta__glow {
    position: absolute;
    inset: -50% -20% auto;
    height: 130%;
    background: var(--glow);
    pointer-events: none;
  }

  .cta__main,
  .cta__side {
    position: relative;
  }

  .cta__lead {
    margin-block: var(--space-s) var(--space-l);
    max-width: 40ch;
  }

  .cta__contact {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .cta__contact a {
    color: var(--brand-text);
    font-weight: 600;
  }

  .cta__side {
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }

  .cta__side-body {
    margin-block: 0.35rem var(--space-m);
    font-size: var(--step--1);
  }

  .cta__fine {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
</style>
