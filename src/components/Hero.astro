---
import { hero } from '@data/site';
import DeviceFrame from './DeviceFrame.astro';
import StoreButtons from './StoreButtons.astro';
import Icon from './Icon.astro';

// The watch frame only appears once there is a real screenshot for it — an
// empty placeholder next to a real one reads as unfinished.
const hasWatchShot = Boolean(hero.watchScreenshot);

const trust = [
  { icon: 'mic' as const, label: 'Voice logging' },
  { icon: 'phone' as const, label: 'iPhone' },
  { icon: 'watch' as const, label: 'Apple Watch' },
  { icon: 'heart' as const, label: 'Apple Health' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="pill hero__pill">
        <span class="pill__dot"></span>
        {hero.eyebrow}
      </p>

      <h1 class="h1" id="hero-title">{hero.headline}</h1>
      <p class="lead hero__lead">{hero.subhead}</p>

      <div class="hero__actions">
        <StoreButtons size="lg" note={hero.ctaNote} />
      </div>

      <ul class="hero__trust">
        {
          trust.map((item) => (
            <li>
              <Icon name={item.icon} size={16} />
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class:list={['hero__visual', hasWatchShot && 'hero__visual--pair']}>
      <DeviceFrame
        device="iphone"
        src={hero.phoneScreenshot}
        alt="RepBud's home screen on iPhone, showing the Hall of Fame and training charts"
        label="[Screenshot: iPhone home]"
        class="hero__phone"
        priority
      />
      {
        hasWatchShot && (
          <DeviceFrame
            device="watch"
            src={hero.watchScreenshot}
            alt="An active workout on Apple Watch"
            label="[Screenshot: Watch]"
            class="hero__watch"
            priority
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) clamp(3.5rem, 2rem + 7vw, 7rem);
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: -30% 0 auto;
    height: 90%;
    background: var(--glow);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-2xl);
    }
  }

  .hero__pill {
    margin-bottom: var(--space-m);
  }

  .hero__lead {
    margin-top: var(--space-m);
    max-width: 34rem;
  }

  .hero__actions {
    margin-top: var(--space-l);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: var(--space-l) 0 0;
    padding: var(--space-m) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--text-muted);
  }

  .hero__trust :global(svg) {
    color: var(--brand-text);
  }

  /* Device cluster --------------------------------------------------------- */
  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* The watch sits over the phone's bottom-right corner, so the cluster needs
     room on that side. Phone-only heroes stay centred instead. */
  .hero__visual--pair {
    padding-inline-end: clamp(2.5rem, 12vw, 5rem);
  }

  .hero__watch {
    position: absolute;
    right: 0;
    bottom: 8%;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.45));
  }

  @media (min-width: 960px) {
    .hero__visual--pair {
      padding-inline-end: 4rem;
      justify-content: flex-end;
    }
  }
</style>
