---
/**
 * Contact block. The form posts to links.contactEndpoint (Formspree, Basin,
 * Web3Forms — anything that accepts a plain POST). Until that is filled in,
 * the whole form collapses into a single prefilled email button, so a visitor
 * can always reach you.
 */
import { contact, brand, socials, links, isPlaceholder, mailto } from '@data/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

const formReady = !isPlaceholder(links.contactEndpoint);
const emailLink = mailto(`Hello from the ${brand.appName} site`);
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <SectionHead
      eyebrow="Contact"
      title={contact.heading}
      lead={contact.subheading}
      align="center"
      id="contact-title"
    />

    <div class="contact">
      <div class="contact__cards" data-reveal>
        <a class="card card--interactive contact__card" href={emailLink}>
          <span class="card__icon"><Icon name="mail" size={21} /></span>
          <h3 class="h4">Email</h3>
          <p class="muted">{brand.email}</p>
          <p class="faint">{contact.responseTime}</p>
        </a>

        <div class="card contact__card">
          <span class="card__icon"><Icon name="sparkles" size={21} /></span>
          <h3 class="h4">Follow along</h3>
          <ul class="contact__socials">
            {
              socials.map((social) => (
                <li>
                  <a href={social.url} target="_blank" rel="noopener">
                    <Icon name={social.icon} size={17} />
                    <span class="contact__social-label">{social.label}</span>
                    <span class="faint">{social.handle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="card contact__form-card" data-reveal>
        <h3 class="h4">Send a message</h3>

        {
          formReady ? (
            <form class="contact__form" action={links.contactEndpoint} method="post">
              <div class="field">
                <label for="contact-name">Name</label>
                <input class="input" id="contact-name" name="name" type="text" required autocomplete="name" />
              </div>

              <div class="field">
                <label for="contact-email">Email</label>
                <input
                  class="input"
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="field">
                <label for="contact-message">Message</label>
                <textarea class="textarea" id="contact-message" name="message" required></textarea>
              </div>

              {/* Honeypot — bots fill it in, humans never see it. */}
              <div class="visually-hidden" aria-hidden="true">
                <label for="contact-company">Company</label>
                <input id="contact-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <button class="btn btn--primary btn--block" type="submit">
                Send message
                <Icon name="arrowRight" size={18} />
              </button>
            </form>
          ) : (
            <div class="contact__fallback">
              <a class="btn btn--primary btn--block" href={emailLink}>
                <Icon name="mail" size={18} />
                Email {brand.email}
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .contact__cards {
    display: grid;
    gap: var(--space-m);
  }

  .contact__card {
    text-decoration: none;
  }

  .contact__socials {
    display: grid;
    gap: 0.15rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__socials a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.15rem;
    border-radius: var(--radius-s);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .contact__socials a:hover {
    color: var(--text);
  }

  .contact__social-label {
    flex: 1;
    font-weight: 560;
  }

  .contact__form,
  .contact__fallback {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
</style>
