---
import { proof } from '@data/site';
import { withBase } from '@utils/url';
import SectionHead from './SectionHead.astro';
---

<section class="section section--soft" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <SectionHead
      eyebrow="Proof"
      title={proof.heading}
      lead={proof.subheading}
      align="center"
      id="proof-title"
    />

    <ul class="grid grid--4 stats" data-reveal>
      {
        proof.stats.map((stat) => (
          <li class="stat">
            <div class="stat__value">{stat.value}</div>
            <div class="stat__label">{stat.label}</div>
          </li>
        ))
      }
    </ul>

    <ul class="grid grid--3 quotes">
      {
        proof.testimonials.map((item, index) => (
          <li class="card quote" data-reveal style={`transition-delay:${index * 70}ms`}>
            <figure>
              <blockquote>{item.quote}</blockquote>
              <figcaption class="quote__who">
                {item.avatar ? (
                  <img src={withBase(item.avatar)} alt="" width="40" height="40" loading="lazy" />
                ) : (
                  <span class="quote__avatar" aria-hidden="true">
                    {item.name.replace(/[^A-Za-z]/g, '').charAt(0) || '?'}
                  </span>
                )}
                <span class="quote__id">
                  <strong>{item.name}</strong>
                  <span class="faint">{item.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats,
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quotes {
    margin-top: var(--space-m);
  }

  .quote figure {
    margin: 0;
  }

  .quote blockquote {
    margin: 0 0 var(--space-m);
    color: var(--text);
    font-size: var(--step-0);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .quote blockquote::before {
    content: '“';
    color: var(--brand-text);
    font-size: 2em;
    line-height: 0;
    vertical-align: -0.35em;
    margin-right: 0.1em;
  }

  .quote__who {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .quote__id span {
    display: block;
  }

  .quote__who strong {
    font-size: var(--step--1);
    font-weight: 620;
  }

  .quote__avatar,
  .quote__who img {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
    color: var(--text-faint);
    font-weight: 700;
  }
</style>
