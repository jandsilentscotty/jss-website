---
/**
 * Everything SEO: title, description, canonical, Open Graph, Twitter card,
 * JSON-LD structured data. Defaults come from src/data/site.ts — pages
 * override them by passing props.
 */
import { brand, seo, socials, links, isPlaceholder } from '@data/site';
import { absoluteUrl, canonicalUrl } from '@utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 'website' for pages, 'article' for blog posts. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** Set true on pages that should stay out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = seo.defaultDescription,
  image = seo.ogImage,
  type = 'website',
  publishedAt,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${brand.name}` : seo.defaultTitle;
const canonical = canonicalUrl(Astro.url, Astro.site);
const ogImage = absoluteUrl(image, Astro.site);

const sameAs = socials.map((s) => s.url);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brand.name,
    url: absoluteUrl('/', Astro.site),
    inLanguage: seo.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: brand.appName,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, watchOS',
    description: seo.defaultDescription,
    ...(isPlaceholder(links.appStore) ? {} : { installUrl: links.appStore }),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: brand.name, url: absoluteUrl('/', Astro.site) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: brand.name,
    url: absoluteUrl('/', Astro.site),
    email: brand.email,
    logo: ogImage,
    sameAs,
  },
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={brand.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${brand.appName} — ${brand.name}`} />
<meta property="og:locale" content="en_US" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:site" content={seo.twitterHandle} />
<meta name="twitter:creator" content={seo.twitterHandle} />

<!-- Icons & feeds -->
<link rel="icon" href={absoluteUrl('/favicon.svg', Astro.site)} type="image/svg+xml" />
<link rel="apple-touch-icon" href={absoluteUrl('/apple-touch-icon.png', Astro.site)} />
<link rel="sitemap" href={absoluteUrl('/sitemap-index.xml', Astro.site)} />
<meta name="theme-color" content="#101416" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fafcff" media="(prefers-color-scheme: light)" />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline></script>
